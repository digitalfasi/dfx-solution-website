// DFX Solution — Lead Generation / CRM data model.
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL to create the tables.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Sales pipeline stage. Drives the future CRM's Kanban board without any
/// schema change — see LeadActivity for the audit trail behind each move.
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  MEETING_BOOKED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  SPAM
}

enum LeadPriority {
  HOT
  WARM
  COLD
}

enum PrimaryService {
  WEBSITE_DEVELOPMENT
  META_ADS
  GOOGLE_ADS
  SEO
  SOCIAL_MEDIA_MARKETING
  AI_AUTOMATION
  CRM_DEVELOPMENT
  CUSTOM_SOFTWARE_DEVELOPMENT
  SAAS_DEVELOPMENT
  BRANDING
  MULTIPLE_SERVICES
  NOT_SURE
}

enum Industry {
  HEALTHCARE_HOSPITAL
  DENTAL_CLINIC
  EDUCATION
  REAL_ESTATE
  ECOMMERCE
  RETAIL
  RESTAURANT_CAFE
  MANUFACTURING
  LEATHER_INDUSTRY
  JEWELLERY
  FINANCE
  TRAVEL_TOURISM
  CONSTRUCTION
  AUTOMOBILE
  TECHNOLOGY
  OTHER
}

enum CompanySize {
  JUST_STARTED
  SIZE_1_10
  SIZE_11_50
  SIZE_51_200
  SIZE_200_PLUS
}

enum MarketingBudget {
  UNDER_25K
  RANGE_25K_50K
  RANGE_50K_1L
  RANGE_1L_3L
  ABOVE_3L
  NOT_DECIDED
}

enum PrimaryGoal {
  GENERATE_MORE_LEADS
  INCREASE_SALES
  BUILD_PREMIUM_WEBSITE
  IMPROVE_SEO
  RUN_META_ADS
  RUN_GOOGLE_ADS
  AI_AUTOMATION
  CRM_DEVELOPMENT
  SAAS_DEVELOPMENT
  BRAND_AWARENESS
  NEED_COMPLETE_GROWTH_STRATEGY
}

enum Timeline {
  IMMEDIATELY
  WITHIN_1_MONTH
  WITHIN_3_MONTHS
  JUST_EXPLORING
}

enum HearAboutUs {
  GOOGLE_SEARCH
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  REFERRAL
  YOUTUBE
  WHATSAPP
  EXISTING_CLIENT
  OTHER
}

enum ProjectBudget {
  UNDER_50K
  RANGE_50K_1L
  RANGE_1L_3L
  RANGE_3L_5L
  ABOVE_5L
  NEED_RECOMMENDATION
}

enum LeadActivityType {
  CREATED
  STATUS_CHANGED
  NOTE_ADDED
  CALL_LOGGED
  EMAIL_SENT
  FOLLOW_UP_SCHEDULED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Core lead record captured from the "Book Your AI Growth Strategy Session"
/// multi-step form. Doubles as the seed table for the future in-house CRM
/// (pipeline, assignment, notes, call logs, timeline) — nothing here needs to
/// change shape for that dashboard to be built on top of it.
model Lead {
  id        String   @id @default(cuid())
  /// Human-readable, publicly shareable reference (e.g. "DFX-8K3N2P1Q"). The
  /// thank-you page and emails show this instead of the internal cuid `id`.
  leadId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Client-captured render timestamp — when the visitor actually completed
  /// the form, which can lag `createdAt` (server receipt) under bad network.
  submittedAt DateTime

  // Step 1 — Contact details
  firstName String
  lastName  String?
  /// Denormalized `${firstName} ${lastName}` for fast search/display in the
  /// future CRM lead list without joining or concatenating at query time.
  fullName    String
  email       String
  phone       String
  countryCode String @default("+91")
  company     String
  website     String?

  // Step 2 — Business information
  industry        Industry
  primaryService  PrimaryService
  companySize     CompanySize
  marketingBudget MarketingBudget

  // Step 3 — Project information
  primaryGoal   PrimaryGoal
  timeline      Timeline
  hearAboutUs   HearAboutUs
  projectBudget ProjectBudget
  message       String?

  // Lead intelligence
  status     LeadStatus   @default(NEW)
  leadScore  Int          @default(0)
  priority   LeadPriority @default(COLD)

  // Attribution
  source      String?
  medium      String?
  campaign    String?
  term        String?
  content     String?
  gclid       String?
  fbclid      String?
  landingPage String?
  referrer    String?

  // Request / device metadata
  browser          String?
  device           String?
  os               String?
  screenResolution String?
  timezone         String?
  language         String?
  country          String?
  city             String?
  ipAddress        String?
  clientId         String?
  sessionId        String?

  // Spam / duplicate protection
  clientRequestId String? @unique

  // CRM pipeline (future dashboard)
  assignedTo     String?
  followUpDate   DateTime?
  proposalSentAt DateTime?
  invoiceSentAt  DateTime?
  closedAt       DateTime?

  notes      LeadNote[]
  callLogs   CallLog[]
  activities LeadActivity[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("leads")
}

/// Free-form notes a sales rep leaves on a lead (future CRM feature).
model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body      String
  createdBy String?
  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("lead_notes")
}

/// Call log entries tied to a lead (future CRM feature).
model CallLog {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  outcome   String?
  notes     String?
  calledAt  DateTime @default(now())
  createdBy String?

  @@index([leadId])
  @@map("call_logs")
}

/// Append-only audit trail behind the future CRM's "Lead Timeline" view —
/// every status change, note, call, and email against a lead in one feed.
model LeadActivity {
  id          String           @id @default(cuid())
  leadId      String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        LeadActivityType
  description String
  metadata    Json?
  createdBy   String?
  createdAt   DateTime         @default(now())

  @@index([leadId])
  @@map("lead_activities")
}
