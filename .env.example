# Postgres connection string (Neon / Vercel Postgres / Supabase / RDS all work).
# The app runtime uses this directly via @prisma/adapter-pg (lib/prisma.ts).
DATABASE_URL="postgresql://user:password@localhost:5432/dfx_solution?schema=public"

# Only needed for connection poolers that don't support Prisma Migrate's
# advisory locks / shadow-database creation (e.g. Supabase's PgBouncer
# transaction-pooled URL on port 6543). Point this at a direct/session
# connection instead — for Supabase, the same pooler host on port 5432
# (no `pgbouncer=true`) or the project's direct-connection host. Used only
# by `prisma.config.ts` for migrate/introspect; leave unset if DATABASE_URL
# already supports migrations directly (e.g. local Postgres, Neon).
DIRECT_URL=""

# --- Site / branding ---------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://www.dfxsolution.com"
NEXT_PUBLIC_COMPANY_NAME="DFX Solution"

# WhatsApp number the "Continue to WhatsApp" buttons open (E.164, no leading +).
NEXT_PUBLIC_WHATSAPP_NUMBER="919344024373"

# --- Transactional email (Resend — https://resend.com) ----------------------
# Leave RESEND_API_KEY unset in local dev and lead emails are skipped (logged),
# lead creation still succeeds.
RESEND_API_KEY=""
# Must be on a domain verified in the Resend dashboard (Domains tab) — the
# onboarding@resend.dev fallback only delivers to the Resend account owner,
# not to real customers or info@dfxsolution.com.
EMAIL_FROM="DFX Solution <info@dfxsolution.com>"
# Internal sales-team lead notification address. Defaults to info@dfxsolution.com
# in code even if unset — set this only to override that default.
INTERNAL_NOTIFICATION_EMAIL="info@dfxsolution.com"

# --- Analytics (all optional; existing GTM/GA4/Meta Pixel/Clarity setup already covers most of this) ---
# Only needed if you want the lead form to also fire a direct Google Ads
# conversion in addition to the GTM-driven GA4/Meta events.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=""
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=""
